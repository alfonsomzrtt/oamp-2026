# ── Server ──────────────────────────────────────────────────────────
API_SERVER_URL=https://api.brainblock.id              # kalau Kosongkan = offline (simpan lokal)
PC_MODE=training             # startup default — bisa diganti via UI

# ── Tampilan ──────────────────────────────────────────────────────────
THEME=dark                   # dark | light — restart diperlukan
DISPLAY_HALF=true            # true = kamera setengah layar
HIDE_CAMERA=false            # true = sembunyiin feed kamera
NORMAL_PATTERN=true          # true = pola BDT standar

# ── Kamera (bisa diset via UI → Simpan) ─────────────────────────────
CAMERA_INDEX=0
CAMERA_MIRROR_X=false
CAMERA_MIRROR_Y=false
CAMERA_ZOOM=1.0              # 0.5–3.0
CAMERA_CALIBRATION=false      # true = pakai setting manual; false = default webcam
CAMERA_BRIGHTNESS=128        # 0–255
CAMERA_CONTRAST=128          # 0–255
CAMERA_SATURATION=128        # 0–255

# ── Tes ─────────────────────────────────────────────────────────────
MAX_LEVEL=8
CUSTOM_LEVEL=                # kosong = acak. Format: 1:2a,2:3b,...
BUTTON_MODE=false            # true = mode ESP32 (butuh hardware)

# ── YOLO & MediaPipe ────────────────────────────────────────────────
YOLO_SKIP_FRAMES=2           # 0=every frame, 2=every 3rd
MEDIAPIPE_SKIP_FRAMES=2      # tinggiin kalo tangan ga dipake
MODEL_BANTAL=false           # true = bantal.pt, false = best.pt
DEBUG_MODE=false
YOLO_AUTOINSTALL=false
